# ── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo local (SQLite). En producción usa PostgreSQL + psycopg v3:
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/financial
DATABASE_URL=sqlite:///./financial.db

# dev | test | prod. En prod no se ejecuta create_all ni seeds.
ENV=dev

# Directorio de ficheros importados (fuera de la BD).
DATA_DIR=data/files

# ── Sesiones / autenticación ─────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio
SESSION_TTL_DAYS=7
# En producción debe ser true (y la cookie pasa a __Host-ft_session).
COOKIE_SECURE=false

# Admin inicial para scripts/create_admin.py.
# ADMIN_PASSWORD_HASH debe ser un hash Argon2id, nunca la contraseña en claro.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# ── Proveedores externos (nunca se loguean) ──────────────────────────────────
LLM_API_KEY=sk-TU_API_KEY_AQUI
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# Lista separada por comas o JSON: ["glm-5.3-flash","qwen3.8-flash"]
OPENCODE_FALLBACK_MODELS=glm-5.3-flash,qwen3.8-flash,mimo-v2.6-flash,gpt-6-luna

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista separada por comas o JSON. En producción limita a tu dominio.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
