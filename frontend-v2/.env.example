# Origin of the FastAPI backend used by the Next.js rewrite.
BACKEND_URL=http://localhost:8001

# Optional public base URL for direct browser calls. Leave empty to use the
# same-origin /api rewrite (recommended: cookies stay first-party).
NEXT_PUBLIC_API_URL=

# Scaffold-only preview mode. When true, /login offers a "demo" access button
# and every screen reads deterministic mock data instead of calling the API.
# Never enable in production.
NEXT_PUBLIC_DEMO_MODE=false
