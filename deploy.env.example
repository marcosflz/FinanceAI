# ─────────────────────────────────────────────────────────────────────────────
# deploy.env — secretos del despliegue Docker
#
# Copia este fichero a ~/.config/financial-tools/deploy.env, chmod 600.
# NO lo pongas en el repo. `scripts/docker-deploy.sh` lo carga con
# `docker compose --env-file`.
#
# Lo que NO va aquí:
#   - DATA_DIR: docker-compose lo fija en /data/files.
#   - OPENCODE_SESSION_ID: se genera por documento.
#   - ADMIN_PASSWORD: solo para el script create_admin, no para el contenedor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatorias ─────────────────────────────────────────────────────────────
# PostgreSQL real. Se normaliza a psycopg v3 automáticamente.
DATABASE_URL=postgresql+psycopg://usuario:password@192.168.1.16:5432/financial
ENV=production
# false solo si sirves por HTTP en LAN; con HTTPS pon true.
COOKIE_SECURE=false
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
SESSION_TTL_DAYS=7
# Dominios desde los que se abre el frontend. En Docker el proxy de Next es
# same-origin, pero se mantiene para CORS directo si hiciera falta.
CORS_ORIGINS=http://localhost:3000,http://192.168.1.16:3000

# ── Modelo documental / agente de extracción (OpenCode Go) ───────────────────
# Clave `oc_sk_...` de la suscripción Go. Sin ella, la extracción falla de
# forma explícita; no hay parser por banco de fallback en producción.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_FALLBACK_MODELS=glm-5.3-flash,qwen3.8-flash,mimo-v2.6-flash,gpt-6-luna
# OCR local para imágenes/PDF escaneados; el texto se interpreta con DeepSeek.
OCR_LANG=spa+eng
OCR_DPI=250

# ── Decisor Jev / TypeSafe ───────────────────────────────────────────────────
# Clave de TypeSafe. Sin ella, la clasificación usa reglas/memoria y el LLM
# de fallback; Jev no se invoca.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# ── Transitorio: fallback de clasificación ───────────────────────────────────
# El pipeline actual todavía usa este LLM si Jev no está configurado o no
# devuelve una categoría. Se puede retirar cuando Jev cubra todo el pipeline.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-nano
# LLM_BASE_URL=

# ── Opcionales de ajuste (los defaults del compose son razonables) ───────────
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_TIMEOUT=5
# JEV_MAX_RETRIES=2
# JEV_BACKOFF=0.5
# JEV_MAX_CALLS_PER_RUN=50
# JEV_REFERENCE_MAX=40
# OPENCODE_BASE_URL=https://opencode.ai/inference/go
# OPENCODE_TIMEOUT=60
# OPENCODE_MAX_RETRIES=3
# OPENCODE_BACKOFF=0.5
# OPENCODE_MIN_ALLOWANCE_PCT=20

# ── Cola de importaciones ───────────────────────────────────────────────────
# worker: el backend encola y `import-worker` procesa (recomendado en Docker).
# inline: procesa dentro de la petición (solo pruebas locales).
# IMPORT_QUEUE_MODE=worker
# IMPORT_WORKER_POLL_SECONDS=2
# IMPORT_WORKER_STALE_MINUTES=30

# ── Admin automático del entrypoint (opcional) ───────────────────────────────
# Si se define, el entrypoint crea/actualiza el admin al arrancar. Para el día
# a día no es necesario: el admin ya existe en PostgreSQL. Si cambias el email
# desde Ajustes → Perfil, actualiza o elimina ADMIN_EMAIL para que el próximo
# arranque no vuelva a crear el usuario con el email antiguo.
# ADMIN_EMAIL=tu@email.com
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
